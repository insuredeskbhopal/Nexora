# Node & Application Environment
# Allowed values: development | test | staging | production
NODE_ENV=development
APP_ENV=development

# Service Ports
WEB_PORT=3000
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000

# PostgreSQL (Development Docker Compose default)
DATABASE_URL=postgresql://agentic:agentic@localhost:5432/agentic_dev?schema=public

# Redis (Development Docker Compose default)
REDIS_URL=redis://localhost:6379

# Temporal Workflow Engine (Development Server & Web UI)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# MinIO / S3 Compatible Object Storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=agentic_minio_admin
S3_SECRET_KEY=agentic_minio_secret_key
S3_BUCKET=agentic-artifacts

# Logging
LOG_LEVEL=info
